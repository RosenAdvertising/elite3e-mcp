# Replace these placeholders with the values supplied for your Elite 3E tenant.
ELITE3E_BASE_URL=https://your-tenant.example/3eapi
ELITE3E_TOKEN_URL=https://identity.example/oauth2/token
ELITE3E_CLIENT_ID=your-client-id
ELITE3E_CLIENT_SECRET=your-client-secret

# Set exactly one authentication field according to the tenant-issued package.
ELITE3E_SCOPE=your-tenant-issued-scope
# ELITE3E_AUDIENCE=your-tenant-issued-audience

# Optional HTTP and retry tuning.
ELITE3E_TIMEOUT_SECONDS=30
ELITE3E_MAX_RETRIES=3
ELITE3E_BACKOFF_SECONDS=0.5

# Optional administrator-controlled delegated identities; empty denies all overrides.
ELITE3E_ALLOWED_USER_IDS=
